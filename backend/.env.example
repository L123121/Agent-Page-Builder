# Server runtime configuration
PORT=8000
DATABASE_URL=sqlite:///./lowcode.db
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# AI (StepFun, OpenAI-compatible)
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.stepfun.com/step_plan/v1  # 免费体验计划 key 的额度挂在该网关；付费 key 用 /v1
AI_MODEL=step-3.7-flash
# Agent 行为调优（可不配，使用内置默认）
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT=120
AI_MAX_AGENT_STEPS=6
AI_CHECKPOINT_BACKEND=memory
AI_THREAD_TTL_SECONDS=3600
AI_CHECKPOINT_MAX_THREADS=500

# Auth (JWT) — 生产必须替换为随机密钥
JWT_SECRET=dev-secret-change-me-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
